# Copie para .env.local (fora do git) e preencha. Na Vercel, cadastre os mesmos
# nomes em Settings > Environment Variables. NUNCA coloque valores reais aqui.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=true
# Token que o ESP32 envia em "Authorization: Bearer <token>" (use um valor longo e aleatorio)
API_TOKEN=
